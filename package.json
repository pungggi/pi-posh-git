{
  "name": "pi-posh-git",
  "version": "1.4.0",
  "description": "posh-git style persistent git status for pi. Displays branch, ahead/behind, staged/unstaged counts, and stash count in the footer — and feeds a timestamped note + compact git status into the agent context.",
  "keywords": [
    "pi-package",
    "pi",
    "pi.dev",
    "pi-extension",
    "git",
    "posh-git",
    "status",
    "widget",
    "note",
    "context"
  ],
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pungggi/pi-posh-git.git"
  },
  "homepage": "https://github.com/pungggi/pi-posh-git#readme",
  "bugs": {
    "url": "https://github.com/pungggi/pi-posh-git/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.1",
    "@earendil-works/pi-tui": ">=0.84.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/pungggi/pi-posh-git/master/screenshot.png"
  },
  "scripts": {
    "prepublishOnly": "node -e \"if(!process.env.CI)throw new Error('publish via release.yml CI: push a v* tag. Manual npm publish is blocked.')\"",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
